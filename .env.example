# PostgreSQL connection string (Neon). Leave empty to use a local SQLite file in .data/.
DATABASE_URL=

# Session cookie encryption key — at least 32 characters. Required in production.
NUXT_SESSION_PASSWORD=

# First start (empty database): the first admin, and the name of the first billing account.
NUXT_SEED_ADMIN_EMAIL=
NUXT_SEED_ADMIN_NAME=
NUXT_SEED_ADMIN_PASSWORD=
NUXT_SEED_ACCOUNT_NAME=My company

# Public base URL, used to build invite links.
NUXT_PUBLIC_SITE_URL=http://localhost:3000
